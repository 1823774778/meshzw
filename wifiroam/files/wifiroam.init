#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	local enabled
	config_load wifiroam
	config_get_bool enabled core enabled 1
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance wifiroam
	procd_set_param command /usr/bin/ucode /usr/share/wifiroam/wifiroamd.uc
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
