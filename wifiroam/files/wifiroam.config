config globals 'core'
	option enabled '1'
	option role 'unconfigured'
	option token ''
	option cap_ip ''
	option name ''
	option offload '0'

config roam 'roam'
	option enabled '1'
	option ft_mode 'simple'
	option ft_over_ds '1'
	option k_neighbor '1'
	option k_beacon '1'
	option v_bss_transition '1'
	option rssi_profile 'balanced'
	option rssi_threshold '-70'
	option config_ver '0'

config backhaul 'backhaul'
	option enabled '0'
	option ssid 'wifiroam-bh'
	option key ''
	option device ''
	option config_ver '0'

config channel 'channel'
	option enabled '0'
	option band2g '1'
	option band5g '1'
	option hour '4'
	option last ''

config guest 'guest'
	option enabled '0'
	option ssid 'Guest'
	option key ''
	option bandwidth '0'
	option schedule '0'
	option start '08:00'
	option end '23:00'
	option allow_lan '0'
	option config_ver '0'

config alias_sync
	option ver '0'
