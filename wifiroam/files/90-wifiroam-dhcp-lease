# netifd sources this in a subshell with jshn loaded after updating the lease.
case "$1" in
	bound|renew) ;;
	*) return 0 ;;
esac
[ "${INTERFACE:-}" = lan ] && [ -n "${interface:-}" ] && [ -n "${ip:-}" ] || return 0

json_init
json_add_string device "$interface"
json_add_string address "$ip"
ubus -t 1 send wifiroam.dhcp_lease "$(json_dump)" >/dev/null 2>&1 || :
